{
  "name": "focus-guard",
  "version": "3.4.1",
  "description": "FocusGuard 聚焦护栏核心包：给 AI 编码智能体（ZCode / DSH 双端原生硬拦截）装上的履职纪律与监察系统。日常零打扰、只查行为；六条钩子覆盖会话启动到收尾全程，含三预算池、L1-L6 梯度处罚、高危命令审批单、KPI 兑现、因果链留痕与积木图书馆。零依赖（Node.js ≥18），是所有人下载的范本包——外接集成见 focus-guard-extended。",
  "displayName": "FocusGuard 聚焦护栏",
  "displayNameI18n": {
    "zh-CN": "聚焦护栏",
    "en": "FocusGuard"
  },
  "descriptionI18n": {
    "zh-CN": "AI 编码智能体的纪律与监察系统：四类失控自动触发 L1-L6 梯度处罚，双端硬拦截、全程留痕、零依赖。",
    "en": "Hook-level guardrails for AI coding agents on DSH: unverified edits, high-risk commands and context-burning reads become mechanically blocked events with an auditable trail."
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18.17"
  },
  "type": "module",
  "main": "./src/dsh/index.js",
  "exports": {
    ".": "./src/dsh/index.js"
  },
  "files": [
    "hooks",
    "tools",
    "skills",
    "docs",
    "src",
    "NOTICE"
  ],
  "scripts": {
    "postinstall": "node tools/first-run-sweep.mjs",
    "test": "node tests/audit-isolation.mjs",
    "eval": "node tests/threat-eval.mjs hooks/guard.mjs",
    "bench": "node tests/token-bench.mjs hooks/guard.mjs",
    "check": "npm run test:all && npm run eval && npm run selftest && npm run schema:verify",
    "test:all": "cd ../.. && node packages/core/tests/audit-isolation.mjs",
    "selftest": "node tools/selftest.mjs",
    "bench:decision": "node tests/decision-bench.mjs",
    "bench:cost": "node tools/bench-cost.mjs",
    "bench:tasks": "node tests/task-bench.mjs",
    "bench:control": "node tests/task-control.mjs",
    "bench:ab": "node tools/bench-ab.mjs",
    "focusguard": "node tools/focusguard.mjs",
    "gate:audit": "node tools/gate-audit.mjs",
    "schema:verify": "node tools/schema-fingerprint.mjs",
    "schema:update": "node tools/schema-fingerprint.mjs --update",
    "fixtures:capture": "node tools/capture-fixtures.mjs",
    "handoff": "node tools/handoff.mjs",
    "layers:audit": "node tools/layering-audit.mjs",
    "brain": "node tools/brain.mjs --open",
    "brain:build": "node tools/brain.mjs",
    "version:check": "node tools/version.mjs",
    "version:set": "node tools/version.mjs --set",
    "manifest:check": "node tools/manifest-sync.mjs",
    "manifest:sync": "node tools/manifest-sync.mjs --write"
  },
  "dsh": {
    "bundle": {
      "patch": "./src/dsh/cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "zcode",
    "agent-hooks",
    "focus",
    "guard",
    "cordis"
  ],
  "homepage": "https://github.com/irisblackwood/focus-guard#readme",
  "bugs": {
    "url": "https://github.com/irisblackwood/focus-guard/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/irisblackwood/focus-guard.git",
    "directory": "packages/core"
  },
  "author": {
    "name": "irisblackwood",
    "url": "https://github.com/irisblackwood"
  }
}
