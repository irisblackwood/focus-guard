{
  "name": "focus-guard",
  "version": "3.5.3",
  "description": "司会（Keepward）核心包：给 AI 编码智能体（ZCode / DSH 双端原生硬拦截）装上的履职纪律与监察系统。三件事：① 硬拦截——六条钩子覆盖会话启动到收尾，三预算池、L1-L6 梯度处罚、高危命令审批单、KPI 兑现；② 长期记忆——反复出现的动作自动沉淀，TTL 到期即遗忘；③ 前缀稳定——观测 system-prompt 装配的前缀抖动，缓存断开即告警。日常零打扰、只查行为，全程因果链留痕，含积木图书馆。零 npm 依赖（Node.js ≥18），是所有人下载的范本包——外接集成见 focus-guard-extended。",
  "displayName": "司会 Keepward",
  "displayNameI18n": {
    "zh-CN": "司会",
    "en": "Keepward"
  },
  "descriptionI18n": {
    "zh-CN": "AI 编码智能体的纪律与监察系统：硬拦截、长期记忆、前缀稳定三件事，双端原生、全程留痕、零依赖。",
    "en": "Discipline and audit for AI coding agents: hard interception, long-term memory, and prompt-prefix stability — dual-host, fully traced, zero dependencies."
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18.17",
    "dsh": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "type": "module",
  "main": "./src/dsh/index.js",
  "exports": {
    ".": "./src/dsh/index.js"
  },
  "files": [
    "hooks",
    "tools",
    "skills",
    "src",
    "assets",
    "NOTICE",
    "docs/RULES.md",
    "docs/THREAT-MODEL.md",
    "docs/ARCH-MAP.md",
    "docs/RELEASE-POLICY.md",
    "docs/BENCH.md",
    "docs/WRITING-STYLE.md"
  ],
  "bin": {
    "focus-guard-brain": "./tools/brain-cosmic.mjs"
  },
  "scripts": {
    "test": "node tests/audit-isolation.mjs",
    "eval": "node tests/threat-eval.mjs hooks/guard.mjs",
    "bench": "node tests/token-bench.mjs hooks/guard.mjs",
    "check": "npm run test:all && npm run eval && npm run selftest && npm run schema:verify",
    "test:all": "cd ../.. && node packages/core/tests/audit-isolation.mjs",
    "selftest": "node tools/selftest.mjs",
    "bench:decision": "node tests/decision-bench.mjs",
    "bench:cost": "node tools/bench-cost.mjs",
    "bench:tasks": "node tests/task-bench.mjs",
    "bench:control": "node tests/task-control.mjs",
    "bench:ab": "node tools/bench-ab.mjs",
    "focusguard": "node tools/focusguard.mjs",
    "gate:audit": "node tools/gate-audit.mjs",
    "schema:verify": "node tools/schema-fingerprint.mjs",
    "schema:update": "node tools/schema-fingerprint.mjs --update",
    "fixtures:capture": "node tools/capture-fixtures.mjs",
    "handoff": "node tools/handoff.mjs",
    "layers:audit": "node tools/layering-audit.mjs",
    "brain": "node tools/brain-cosmic.mjs",
    "brain:build": "node tools/brain-cosmic.mjs --quiet",
    "version:check": "node tools/version.mjs",
    "version:set": "node tools/version.mjs --set",
    "manifest:check": "node tools/manifest-sync.mjs",
    "manifest:sync": "node tools/manifest-sync.mjs --write",
    "brain:distill": "node tools/memory-distill.mjs",
    "brain:asset": "node tools/make-cortex-asset.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./src/dsh/cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "zcode",
    "keepward",
    "sihui",
    "agent-hooks",
    "agent-guard",
    "agent-memory",
    "prompt-cache",
    "cordis"
  ],
  "homepage": "https://github.com/irisblackwood/focus-guard#readme",
  "bugs": {
    "url": "https://github.com/irisblackwood/focus-guard/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/irisblackwood/focus-guard.git",
    "directory": "packages/core"
  },
  "author": {
    "name": "irisblackwood",
    "url": "https://github.com/irisblackwood"
  }
}
