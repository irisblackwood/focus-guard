{
  "name": "focus-guard-monorepo",
  "version": "3.0.4",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "focus-guard-monorepo",
      "version": "3.0.4",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
