    },
    "packages/core": {
      "name": "focus-guard",
      "version": "3.0.4",
      "license": "MIT",
      "engines": {
        "node": ">=18.17"
      }
    },
    "packages/extended": {
      "name": "focus-guard-extended",
      "version": "3.0.4",
      "license": "MIT",
      "dependencies": {
        "focus-guard": "^3.0.4"
      },
      "engines": {
        "node": ">=18.17"
      }
    }
  }
}
