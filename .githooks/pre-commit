#!/bin/sh
# FocusGuard 提交闸（pre-commit）：静态闸门 + 生成物自动刷新。
#
# 为什么闸门挪到提交时：闸门要人「记得跑」，就等于大部分时候没跑。
# 提交是每个改动都必经的动作，把它挂在提交上，「每次改动都跑一遍」才不需要记性。
# 分工：
#   pre-commit —— 静态闸（约 7 秒，不跑测试）：lint / 文档 / 旧写法 / 结构 / 契约。
#                 挡的是「这段代码/这份文档本身就不成立」，改完当场就能改。
#   pre-push   —— 全量（npm run check）：测试 + 对抗评测 + 上面那一整套。
#                 挡的是「行为变了」，代价高，放推送。
#
# 为什么刷新生成物：`docs/STATUS.md` 与 `docs/MODULES.md` 是「真值的渲染结果」，
# 含「距今天数」「其后全仓提交」这类**会随「现在」变**的量。靠人记得跑 docs:status /
# modules:sync 是不现实的——忘一次就落后一天，而落后的台账比没有台账更坏（它看着像真话）。
# 那两条判据（status-table-stale / modules-doc-stale）只比**结构指纹**，不逐字比：
# 逐字比等于每天必须重生成，「永久红的闸门等于没有闸门」。
#
# 启用：git config core.hooksPath .githooks（本仓已设）
set -u
cd "$(git rev-parse --show-toplevel)" 2>/dev/null || exit 0

# 没有 node 就静默跳过：钩子不该在别人的环境里把提交卡死
command -v node >/dev/null 2>&1 || exit 0

# 先刷新生成物，再跑闸——否则闸门量的是上一轮的台账。
for s in docs:status modules:sync; do
  npm run --silent "$s" >/dev/null 2>&1 || echo "[pre-commit] $s 未跑通，生成物可能落后" >&2
done

for f in docs/STATUS.md docs/MODULES.md; do
  [ -f "$f" ] || continue
  if ! git diff --quiet -- "$f" 2>/dev/null; then
    git add -- "$f" && echo "[pre-commit] 已刷新 $f"
  fi
done

# 静态闸。任一条红即阻止提交——坏提交不落地，比事后回滚便宜。
t0=$(date +%s)
if npm run --silent gate:fast; then
  echo "[pre-commit] 静态闸全绿（$(( $(date +%s) - t0 ))s）"
  exit 0
fi

echo "" >&2
echo "[pre-commit] 静态闸未通过（$(( $(date +%s) - t0 ))s）→ 提交已阻止。" >&2
echo "[pre-commit] 上面最后一段输出就是没过的那个闸，按它指的位置改；改完重提即可。" >&2
echo "[pre-commit] 全量（含测试）在 pre-push 跑，不必在这里跑。" >&2
echo "[pre-commit] 强行提交（--no-verify）属绕过质量闸，按法规须先批示。" >&2
exit 1
